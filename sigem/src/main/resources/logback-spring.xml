<?xml version="1.0" encoding="UTF-8"?>
<!-- Registro de eventos de SIGEM: consola en desarrollo y archivo diario con rotación. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="APP" source="spring.application.name" defaultValue="SIGEM"/>
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
    <property name="PATRON" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Un archivo por día, se conservan 30 días y como máximo 500 MB. -->
    <appender name="ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/sigem.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/sigem-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATRON}</pattern>
        </encoder>
    </appender>

    <!-- Errores en archivo aparte para revisión rápida. -->
    <appender name="ERRORES" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/sigem-errores.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/sigem-errores-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>60</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${PATRON}</pattern>
        </encoder>
    </appender>

    <logger name="com.transur.sigem" level="INFO"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.springframework.security" level="WARN"/>

    <springProfile name="dev">
        <logger name="com.transur.sigem" level="DEBUG"/>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLA"/>
        <appender-ref ref="ARCHIVO"/>
        <appender-ref ref="ERRORES"/>
    </root>
</configuration>
